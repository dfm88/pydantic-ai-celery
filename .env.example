# Copy to .env. tests/conftest.py and examples/durable_run.py load that file.
# A variable already set in the environment is left as it is.

# Celery broker. Database 0 on this repo's Compose Redis (host port 6389).
CELERY_BROKER_URL=redis://localhost:6389/0

# Journal for the integration tests and for examples/durable_run.py.
# Database 1, separate from the broker.
REDIS_URL=redis://localhost:6389/1

# Postgres journal. The integration test runs when this is set.
POSTGRES_URL=postgresql://celery:celery@localhost:5444/celery

# Only examples/durable_run.py needs this (openai:gpt-5).
# Unit tests and examples/trace_local.py do not.
OPENAI_API_KEY=
